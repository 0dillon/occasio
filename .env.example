# Copy to .env.local. Names and descriptions only; never commit real values.

# --- Database (server only) ---
# Driver: "pg" (TCP, default) or "neon" (Neon serverless driver over
# WebSockets on 443; use on serverless hosts or where port 5432 is blocked).
DATABASE_DRIVER=pg
# Owner role: runs migrations only.
DATABASE_URL_OWNER=postgres://occasio_owner:CHANGE_ME@localhost:5432/occasio_dev
# Request-scoped app role (not owner, no BYPASSRLS).
DATABASE_URL_APP=postgres://occasio_app:CHANGE_ME@localhost:5432/occasio_dev
# Trusted worker role.
DATABASE_URL_WORKER=postgres://occasio_worker:CHANGE_ME@localhost:5432/occasio_dev

# --- App ---
APP_ORIGIN=http://localhost:3000
# "development" enables labelled dev adapters (mail sink, rule-based extraction).
OCCASIO_MODE=development

# --- Storage (server only) ---
# "disk" (dev, private directory never under public/) or "s3" (private
# S3-compatible bucket, e.g. Neon object storage).
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Runtime role passwords (used once by `npm run db:setup-roles`) ---
OCCASIO_APP_DB_PASSWORD=
OCCASIO_WORKER_DB_PASSWORD=

# --- Restricted fetcher (server-to-server only) ---
FETCHER_URL=http://127.0.0.1:4100
FETCHER_TOKEN=CHANGE_ME_long_random

# --- AI provider (worker only; optional) ---
# When unset, extraction is rule-based and uncertain cases go to human review.
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Email provider (worker only; optional) ---
# When unset in development, mail goes to the dev sink (/admin/mail).
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# --- Neon Realtime (optional; live notification bell) ---
# Server-only secret used to seal live queries. Never expose it.
NEON_REALTIME_SECRET=
# Public WebSocket URL (same value as NEON_REALTIME_URL from `neon env pull`).
NEXT_PUBLIC_NEON_REALTIME_URL=
